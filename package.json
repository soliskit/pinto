{
  "name": "pinto",
  "version": "0.1.0",
  "engines": {
    "node": "22.x"
  },
  "website": "https://pintopinto.herokuapp.com/",
  "scripts": {
    "build": "tsc",
    "start": "node ./build/index.js",
    "dev": "npm run build && npx nodemon",
    "prod": "npx heroku local -p 443",
    "logs": "npx heroku logs --tail --source app",
    "pretty-quick": "pretty-quick",
    "lint": "eslint .",
    "prepare": "husky"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "peer": "^1.0.2",
    "socket.io": "^4.8.4"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npx lint-staged && npx pretty-quick --staged",
      "pre-push": "npx tsc && npm run lint"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "nodemonConfig": {
    "verbose": true,
    "watch": [
      ".env",
      "src"
    ],
    "ext": "ts",
    "exec": "ts-node ./src/index.ts --pretty"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9",
    "pretty-quick": "^4.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "author": "David Solis",
  "repository": "https://github.com/pinto-pinto/pinto",
  "description": "WebRTC signal server for peer connections.",
  "keywords": [
    "WebSocket Server",
    "Heroku",
    "Socket.io",
    "PeerJS Server"
  ],
  "private": true
}
